function(compareScenario)
    foreach(mode RANGE 0 3)
        math(EXPR enabled "${mode} % 2")
        math(EXPR retry "${mode} / 2")
        execute_process(COMMAND "${BENCHMARK}" --users 200 --positions-per-user 4 --symbols 7 --waves 8
            --audit-fingerprint 1 --insurance-prefilter ${enabled} --retry-cache ${retry} ${ARGN}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
        if(NOT result EQUAL 0 OR NOT output MATCHES "validation=passed")
            message(FATAL_ERROR "Liquidation differential scenario failed: ${error}\n${output}")
        endif()
        string(REGEX MATCH "state_fingerprint=[0-9]+ event_fingerprint=[0-9]+" fingerprint "${output}")
        if(fingerprint STREQUAL "")
            message(FATAL_ERROR "Differential audit output is missing")
        endif()
        if(enabled EQUAL 1 AND output MATCHES "insurance_prefilter_rejections=[1-9][0-9]*")
            set(exercised TRUE PARENT_SCOPE)
        endif()
        if(retry EQUAL 1 AND output MATCHES "liquidation_retry_cache_hits=[1-9][0-9]*")
            set(retryExercised TRUE PARENT_SCOPE)
        endif()
        if(mode EQUAL 0)
            set(expected "${fingerprint}")
        elseif(NOT fingerprint STREQUAL expected)
            message(FATAL_ERROR "Prefiltered execution changed ledger/order/position/event state: ${expected} != ${fingerprint}")
        endif()
    endforeach()
endfunction()

# Both sides, both implementations and margin modes, partial depth, exhausted
# insurance followed by recapitalization, bounded scheduling, and traffic.
set(exercised FALSE)
set(retryExercised FALSE)
foreach(direction down up)
    foreach(book radix tree)
        compareScenario(--direction ${direction} --book ${book} --trades-per-wave 20)
    endforeach()
    compareScenario(--direction ${direction} --cross-percent 0 --insurance-percent 0)
    compareScenario(--direction ${direction} --cross-percent 100 --insurance-percent 0 --candidate-budget 31)
    compareScenario(--direction ${direction} --depth-percent 0 --insurance-percent 0 --recover 0)
    compareScenario(--direction ${direction} --fee-rate 500 --trades-per-wave 20)
endforeach()
if(NOT exercised)
    message(FATAL_ERROR "Differential scenarios did not exercise the insurance rejection filter")
endif()
if(NOT retryExercised)
    message(FATAL_ERROR "Differential scenarios did not exercise the liquidation retry cache")
endif()
