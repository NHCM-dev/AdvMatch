{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ADVMATCH_BUILD_BENCHMARKS": "ON",
        "ADVMATCH_STATIC_MINGW_RUNTIME": "ON",
        "ADVMATCH_USE_SYSTEM_DEPENDENCIES": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "performance",
      "displayName": "Release with IPO (portable)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/performance",
      "cacheVariables": {
        "ADVMATCH_ENABLE_IPO": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release with JNI",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "ADVMATCH_BUILD_JNI": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "performance",
      "configurePreset": "performance"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "performance",
      "configurePreset": "performance",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
